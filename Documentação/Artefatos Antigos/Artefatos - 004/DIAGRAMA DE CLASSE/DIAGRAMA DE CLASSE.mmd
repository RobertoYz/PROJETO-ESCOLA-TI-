classDiagram
    direction TB

    %% ----------------------------------------------------
    %% 1. CLASSES DE DOMÍNIO (MODELOS ELOQUENT)
    %% ----------------------------------------------------

    class Plano {
        -BigInt id
        -String nome
        -Decimal preco
        -Int limite_startups
    }

    class Agencia {
        -BigInt id
        -BigInt plano_id
        -String nome
        -String id_plataforma_pagamento
        -Enum status_pagamento
        +assinarPlano(Plano plano) void
        +atingiuLimiteStartups() Boolean
    }

    class Usuario {
        -BigInt id
        -BigInt agencia_id
        -String name
        -String email
        -String password
        -String perfil_acesso
        +createToken(String name) Token
        +temPermissao(String perfil) Boolean
    }

    class Startup {
        -BigInt id
        -BigInt agencia_id
        -String cnpj
        -String razao_social
        -String nome_fantasia
        -String porte
        -String regime_tributario
        -String nicho_atuacao
        -Int nivel_trl
        -Text pitch
        +atualizarPerfil(Array dados) void
        +calcularCompatibilidade(Edital edital) Float
    }

    class Edital {
        -BigInt id
        -String title
        -String fonte
        -Text objetivo
        -Decimal min_budget
        -Decimal max_budget
        -DateTime deadline
        -Json documentos
        -Json ai_diagnosis
        +extrairDadosVetoriais() void
    }

    class KanbanBoard {
        -BigInt id
        -BigInt startup_id
        -String title
        +adicionarColuna(String title, Int pos) KanbanColumn
    }

    class KanbanColumn {
        -BigInt id
        -BigInt board_id
        -String title
        -Int position
        +reordenar(Int novaPosicao) void
    }

    class KanbanCard {
        -BigInt id
        -BigInt board_id
        -BigInt column_id
        -BigInt edital_id
        -String title
        -Double position
        -Json metadata
        +moverPara(BigInt colunaId, Double pos) void
    }

    class Minuta {
        -BigInt id
        -BigInt startup_id
        -BigInt edital_id
        -BigInt user_id
        -BigInt kanban_card_id
        -BigInt parent_minuta_id
        -Int versao
        -String titulo_projeto
        -Text ideia_projeto
        -LongText conteudo_gerado
        -Json secoes_estruturadas
        -String status
        -String modelo_ia_usado
        -String autor_nome
        +criarNovaVersao(Array novosDados) Minuta
        +exportarDocx() File
        +exportarPdf() File
    }

    %% ----------------------------------------------------
    %% RELACIONAMENTOS DOS MODELOS (MULTI-TENANCY REAL)
    %% ----------------------------------------------------

    Plano "1" -- "*" Agencia : assina
    Agencia "1" *-- "*" Usuario : possui_membros
    Agencia "1" *-- "*" Startup : gerencia

    Startup "1" *-- "1" KanbanBoard : possui_pipeline
    KanbanBoard "1" *-- "*" KanbanColumn : contem_etapas
    KanbanColumn "1" *-- "*" KanbanCard : organiza
    KanbanCard "*" -- "0..1" Edital : referente_a

    Startup "1" *-- "*" Minuta : proponente
    Edital "1" *-- "*" Minuta : alvo_de
    Usuario "1" *-- "*" Minuta : elaborada_por
    KanbanCard "0..1" *-- "*" Minuta : vinculada_a
    Minuta "1" *-- "*" Minuta : versao_anterior (parent_minuta_id)

    %% ----------------------------------------------------
    %% 2. CLASSES DE SERVIÇO E ARQUITETURA
    %% ----------------------------------------------------

    class MinutaAiService {
        +gerarMinuta(Startup startup, Edital edital, String ideia) Array
        +calcularMatchEditais(Startup startup, Collection editais) Array
        -callGemini(String prompt) Array
        -callDeepSeek(String prompt) Array
        -gerarMinutaFallback(Startup startup, Edital edital, String ideia) Array
    }

    class DocumentExportService {
        +gerarDocx(Minuta minuta) String
        +gerarPdf(Minuta minuta) String
        -montarOpenXmlZip(Minuta minuta) BinaryStream
    }

    class PdfExtractorService {
        +extrairTexto(String caminhoPdf) String
        +parseDatasRegex(String texto) Array
        +parseOrcamentoRegex(String texto) Decimal
    }

    class AbacatePayService {
        +criarCobrancaPix(Agencia agencia, Plano plano) Array
        +processarWebhook(Array payload) Boolean
    }

    %% ----------------------------------------------------
    %% DEPENDÊNCIAS DE SERVIÇOS
    %% ----------------------------------------------------

    MinutaAiService ..> Minuta : gera_ou_revisa
    MinutaAiService ..> Startup : analisa_dados
    MinutaAiService ..> Edital : analisa_diretrizes
    DocumentExportService ..> Minuta : exporta_docx_pdf
    PdfExtractorService ..> Edital : extrai_texto_vetorial
    AbacatePayService ..> Agencia : liquida_plano
