APP_NAME="Anjo Nexus"
APP_ENV=production
APP_KEY=base64:COLOQUE_SUA_APP_KEY_AQUI
APP_DEBUG=false
APP_URL=http://anjonexus.intalenti.com.br
FRONT_URL=http://anjonexus.intalenti.com.br

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ----------------------------------------------------
# BANCO DE DADOS EM PRODUÇÃO (cPanel / MySQL)
# Preencha com os dados do banco criado no seu cPanel
# ----------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=usuario_anjonexus
DB_USERNAME=usuario_banco
DB_PASSWORD=SUA_SENHA_DO_BANCO_AQUI

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ----------------------------------------------------
# SERVIÇO DE E-MAIL (SMTP GMAIL / PROJETO ANJO NEXUS)
# ----------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=projetoanjonexus@gmail.com
MAIL_PASSWORD=SUA_SENHA_DE_APP_GMAIL_AQUI
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=projetoanjonexus@gmail.com
MAIL_FROM_NAME="Anjo Nexus"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ----------------------------------------------------
# PROVEDORES DE IA (ROTAÇÃO AUTOMÁTICA EM CASCATA)
# ----------------------------------------------------
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# ----------------------------------------------------
# GATEWAY DE PAGAMENTO (ABACATEPAY)
# ----------------------------------------------------
ABACATEPAY_API_KEY=
ABACATEPAY_WEBHOOK_SECRET=
