# ==============================================================================
# ANJO NEXUS — VARIAVEIS DE AMBIENTE PARA ORQUESTRACAO DOCKER COMPOSE
# Copie este arquivo para .env.docker na mesma pasta (MVPs/Versão Atual/):
#   cp .env.docker.example .env.docker
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APLICACAO E CONTROLE DE BOOT DO BANCO DE DADOS
# ------------------------------------------------------------------------------
APP_NAME="Anjo Nexus"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONT_URL=http://localhost:5500

# Define se o container 'back' deve recriar e semear o banco do zero na subida:
# - true  -> executa 'php artisan migrate:fresh --seed --force' (ideal para 1ª subida ou reset limpo)
# - false -> executa 'php artisan migrate --force' preservando os dados existentes no volume mysql_data
DOCKER_FRESH_DB=true

# ------------------------------------------------------------------------------
# 2. BANCO DE DADOS MYSQL 8.0 (Anti-conflito com XAMPP local na porta 3306)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_EXTERNAL_PORT=3307
DB_DATABASE=anjonexus
DB_USERNAME=anjonexus
DB_PASSWORD=root
DB_ROOT_PASSWORD=root

# Portas expostas no Host
API_EXTERNAL_PORT=8000
FRONT_EXTERNAL_PORT=5500

# Drivers internos do Laravel
SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

# Politica LGPD de expurgo automatico (assinaturas:processar-ciclo)
ASSINATURA_DIAS_EXPURGO_NUNCA_PAGO=3
ASSINATURA_DIAS_EXPURGO_SUSPENSA=30

# ------------------------------------------------------------------------------
# 3. GATEWAY DE PAGAMENTO (ABACATEPAY API v2 - PIX & CARD)
# ------------------------------------------------------------------------------
ABACATEPAY_API_KEY=
ABACATEPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 4. ROTEADOR MULTI-LLM (IA - Suporta multiplas chaves separadas por virgula)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# ------------------------------------------------------------------------------
# 5. SERVIDOR DE E-MAIL SMTP (Alertas de Prazo, Vencimento e Recuperacao de Senha)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=projetoanjonexus@gmail.com
MAIL_PASSWORD=sua_senha_de_app_google
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=projetoanjonexus@gmail.com
MAIL_FROM_NAME="Anjo Nexus"

# ------------------------------------------------------------------------------
# 6. TUNELAMENTO NGROK (Usado apenas quando acionado com --profile ngrok)
# ------------------------------------------------------------------------------
NGROK_AUTHTOKEN=
NGROK_DOMAIN=esophagus-swifter-cultivate.ngrok-free.dev
